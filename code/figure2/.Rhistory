library(lme4)
library(lmerTest)
nanmean=function(x)(mean(x,na.rm=T))
se <- function(x) {
se <- sd(x, na.rm = TRUE) / sqrt(sum(!is.na(x)))
return(se=se)
}
ci95 <- function(x) {
se <- sd(x, na.rm = TRUE) / sqrt(sum(!is.na(x)))
mean_x <- mean(x, na.rm = TRUE)
error_margin <- qt(0.975, df = sum(!is.na(x)) - 1) * se
lower <- mean_x - error_margin
upper <- mean_x + error_margin
return(c(mean = mean_x, lowerCI = lower, upperCI = upper))
}
