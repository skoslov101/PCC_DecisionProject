corrArr$wofAll[i]=wofResp
corrArr$wofSafe[i]=wofSafe
corrArr$wofRisky[i]=wofRisky
corrArr$wofDiff[i]=wofRisky-wofSafe
corrArr$rddAll[i]=rddResp
corrArr$rddSafe[i]=rddSafe
corrArr$rddRisky[i]=rddRisky
corrArr$rddDiff[i]=rddRisky-rddSafe
}
