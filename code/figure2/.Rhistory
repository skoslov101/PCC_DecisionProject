allPlot1=ggplot() + theme_bw() + geom_point(data=corrArr2,aes(x=rddAll,y=wofAll,color=clustVal)) + geom_smooth(data=corrArr2,aes(x=rddAll,y=wofAll,color=clustVal),method='glm',se=T) + xlab('Feedback Mean PSC (1:500ms) - RDD') + ylab('Feedback Mean PSC (1:500ms) - WoF') + ggtitle('Feedback - Mean ~Overall~ PSC - Across Tasks')
allPlot1
lmTest=lmer(wofAll~rddAll*clustVal+(1|Subject),data=corrArr2)
summary(lmTest)
confint(lmTest,method='Wald')
lmTestb=lmer(wofAll~rddAll+clustVal+(1|Subject),data=corrArr2)
summary(lmTestb)
c1dat=corrArr2[corrArr2$clustVal=='1',]
lmTestD=lmer(wofAll~rddAll+(1|Subject),data=corrArr2[corrArr2$clustVal=='1',])
summary(lmTestD)
confint(lmTestD,method='Wald')
r.squaredGLMM(lmTestD)
