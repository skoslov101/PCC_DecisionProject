merge3 <- merge(regWof3, regRDD3[,c('elecID','psc.mean')], by = c("elecID"))
names(merge3)=c('elecID','locName','clustVal','valPSC','memPSC')
merge3$Subject=substr(merge3$elecID,1,6)
merge3$Subject=as.factor(merge3$Subject)
str(merge3)
